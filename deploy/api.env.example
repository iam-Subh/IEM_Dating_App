# The API's settings on the server: copy to deploy/api.env and fill in.
# deploy/api.env is git-ignored. Never commit it, never paste it anywhere.
# DATABASE_URL, REDIS_URL, FACE_SERVICE_URL, PORT, NODE_ENV and TRUST_PROXY_HOPS
# are set by deploy/docker-compose.prod.yml - leave them out.

# Fixed names: keep exactly these.
JWT_ISSUER=iem-connect-api
JWT_AUDIENCE=iem-connect-mobile

# Sign-in and security: make each one a new long random value (openssl rand -hex 32). Never reuse the local ones.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HMAC_SECRET=
DISCOVERY_CURSOR_SECRET=
FACE_KEY_SECRET=

# Addresses: the tunnel's https address, and the admin panel's.
PUBLIC_WEB_URL=
CORS_ORIGIN=

# Photos and videos: Cloudflare R2.
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
CDN_URL=
MEDIA_CACHE_TTL=

# Only if STORAGE_PROVIDER is s3 instead of r2.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_PRIVATE_MEDIA_BUCKET=

# Email (OTP codes, college verification).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
GRIEVANCE_OFFICER=

# Push notifications and Google sign-in.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_ENDPOINT=
GOOGLE_CLIENT_IDS=

# Everything else, as in apps/api/.env.example.
MUSIC_ENABLED=
MUSIC_API_BASE_URL=
LYRICS_API_BASE_URL=
MUSIC_API_TIMEOUT_MS=
LYRICS_USER_AGENT=
GIPHY_API_KEY=
PLACES_API_BASE_URL=
SAFE_BROWSING_API_KEY=
DISCOVERY_TELEMETRY_SAMPLE_RATE=
STORY_LIFECYCLE_JOBS=
SEARCH_DAILY_CEILING=
NUDITY_REVIEW=
NUDITY_BLOCK=
REAL_PERSON_REQUIRED=
