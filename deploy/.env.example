# Settings for deploy/docker-compose.prod.yml itself: copy to deploy/.env and fill in.
# deploy/.env is git-ignored. Never commit it.

# The database password: a new long random value (openssl rand -hex 24).
POSTGRES_PASSWORD=

# The API's address - fill in the one you use:
# --profile duckdns (free): your DuckDNS name, e.g. iemconnect.duckdns.org
API_DOMAIN=
# --profile tunnel: Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token.
TUNNEL_TOKEN=

# Nightly backup (deploy/backup.sh) to a private Cloudflare R2 bucket.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
