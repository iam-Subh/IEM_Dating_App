{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "connect": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/connect-phone.ps1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:chat": "node --test tests/messageWindow.test.cjs tests/messageListModel.test.cjs tests/offlineQueue.test.cjs tests/socket.test.cjs tests/sentMediaCache.test.cjs tests/historyPrefetch.test.cjs tests/sharedMediaItems.test.cjs tests/openChatAtMessage.test.cjs",
    "test:auth": "node --test tests/api-session.test.cjs tests/session-logout.test.cjs tests/credential-store.test.cjs",
    "test:stories": "node --test tests/storyNavigation.test.cjs tests/storyCreation.test.cjs",
    "release:validate": "node scripts/validate-release.cjs",
    "release:validate:environment": "node scripts/validate-release.cjs --environment",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
