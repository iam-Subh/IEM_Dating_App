# Database Connections
DATABASE_URL="postgresql://iem_dating_user:iem_dating_password@localhost:5432/iem_dating_db?schema=public"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Security
PORT=3000
JWT_ACCESS_SECRET="your-access-secret-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars-long"
JWT_ISSUER="iem-connect-api"
JWT_AUDIENCE="iem-connect-mobile"
OTP_HMAC_SECRET="your-independent-otp-hmac-secret-min-32-chars"
DISCOVERY_CURSOR_SECRET="your-independent-discovery-cursor-secret-min-32-chars"

# Media storage: "r2" (Cloudflare R2) or "aws" (AWS S3). Both blocks can stay
# filled in; only the chosen one is used. Profile and private chat media must
# use separate buckets on either. Story captions need AWS (Transcribe) and
# report CAPTIONS_UNAVAILABLE on R2.
STORAGE_PROVIDER="r2"

# Cloudflare R2. R2_PUBLIC_URL is the public bucket's r2.dev URL or custom
# domain; the private bucket must stay private (no public access).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET="iem-connect-public"
R2_PRIVATE_BUCKET="iem-connect-private"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# AWS S3 (kept for switching back: set STORAGE_PROVIDER="aws").
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="your-profile-media-bucket"
AWS_PRIVATE_MEDIA_BUCKET="your-private-chat-media-bucket"
CDN_URL=""
MEDIA_CACHE_TTL=3600

# Email verification
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="IEM Connect <noreply@example.com>"


# Expo push delivery. EXPO_ACCESS_TOKEN is required only when enhanced push security is enabled.
EXPO_ACCESS_TOKEN=""
EXPO_PUSH_ENDPOINT="https://exp.host/--/api/v2/push/send"

# Story music: JioSaavn through an unofficial API, lyrics from LRCLIB.
# MUSIC_ENABLED="false" hides music and returns MUSIC_UNAVAILABLE.
MUSIC_ENABLED="true"
MUSIC_API_BASE_URL="https://my-saavan-api.vercel.app"
LYRICS_API_BASE_URL="https://lrclib.net"
MUSIC_API_TIMEOUT_MS=4000
LYRICS_USER_AGENT="IEMConnect/1.0 (story music lyrics)"

# Story stickers. GIFs need a GIPHY API key; without it the GIF tray reports GIFS_UNAVAILABLE.
GIPHY_API_KEY=""
PLACES_API_BASE_URL="https://photon.komoot.io"
# Optional Google Safe Browsing check for link stickers.
SAFE_BROWSING_API_KEY=""

# Environment
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8081,http://localhost:5174"

# Fraction of discovery pages with detailed timing events (0 to 1). State counts remain enabled.
DISCOVERY_TELEMETRY_SAMPLE_RATE=0.1

# Number of reverse proxies in front of the API (ngrok or a load balancer = 1,
# direct exposure = 0). Must match the real hop count: a value higher than
# reality lets clients spoof X-Forwarded-For and bypass the auth/OTP rate limiter.
TRUST_PROXY_HOPS=0

# Stories, Part 3 (STORY_ARCHIVE_SPEC.md, section 12): the background worker
# that freezes each Story's viewer list 48 hours after it ends (irreversible:
# viewer names are deleted for good) and deletes media that is no longer
# needed. Off by default. Turning this on for the first time immediately
# freezes every Story already past 48 hours.
STORY_LIFECYCLE_JOBS=0

# People search: distinct profiles returned per account per day before Search slows down and flags the account (SEARCH_SPEC.md 8.3)
SEARCH_DAILY_CEILING=400

# Google sign-in: the Web client ID(s) Google issues sign-in tokens to, comma-separated.
GOOGLE_CLIENT_IDS=""

# Real-person check (apps/face-service): dlib face matching, private.
FACE_SERVICE_URL=http://127.0.0.1:8090
# Nudity check (docs/NUDITY_CHECK.md): from REVIEW the team decides, from BLOCK it is refused.
NUDITY_REVIEW=0.5
NUDITY_BLOCK=0.9
# Encrypts stored face keys at rest (32+ random characters). Required in production.
FACE_KEY_SECRET=
# Google accounts must pass the real-person check within 14 days. Turn on once the app with the selfie camera is out.
REAL_PERSON_REQUIRED=false

# Published documents and support (docs/SAFETY_PROCESSES.md). The Grievance
# Officer line is shown as written: name, title, postal address, email.
SUPPORT_EMAIL="noreply.iemconnect@gmail.com"
GRIEVANCE_OFFICER=""
# Where /legal and /account/delete are served (for links in emails and stores).
PUBLIC_WEB_URL="http://localhost:3000"
