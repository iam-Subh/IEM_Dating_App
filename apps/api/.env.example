# Database Connections
DATABASE_URL="postgresql://iem_dating_user:iem_dating_password@localhost:5432/iem_dating_db?schema=public"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Security
PORT=3000
JWT_ACCESS_SECRET="your-access-secret-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars-long"
JWT_ISSUER="iem-connect-api"
JWT_AUDIENCE="iem-connect-mobile"
OTP_HMAC_SECRET="your-independent-otp-hmac-secret-min-32-chars"
DISCOVERY_CURSOR_SECRET="your-independent-discovery-cursor-secret-min-32-chars"

# Profile and private chat media must use separate buckets.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="your-profile-media-bucket"
AWS_PRIVATE_MEDIA_BUCKET="your-private-chat-media-bucket"
CDN_URL=""
MEDIA_CACHE_TTL=3600

# Email verification
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="IEM Connect <noreply@example.com>"

# Phone verification
SMS_TRANSPORT="msg91"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Expo push delivery. EXPO_ACCESS_TOKEN is required only when enhanced push security is enabled.
EXPO_ACCESS_TOKEN=""
EXPO_PUSH_ENDPOINT="https://exp.host/--/api/v2/push/send"

# Environment
NODE_ENV="development"
CORS_ORIGIN="http://localhost:8081"

# Fraction of discovery pages with detailed timing events (0 to 1). State counts remain enabled.
DISCOVERY_TELEMETRY_SAMPLE_RATE=0.1
