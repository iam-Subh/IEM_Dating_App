generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_URL")
  relationMode      = "prisma"
}

model User {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?           @unique @db.VarChar(255)
  phone              String?           @unique @db.VarChar(20)
  name               String            @db.VarChar(255)
  passwordHash       String            @map("password_hash") @db.VarChar(255)
  college            String?           @db.VarChar(255)
  department         String?           @db.VarChar(100)
  graduationYear     Int?              @map("graduation_year")
  yearOfStudy        Int?              @map("year_of_study")
  birthday           DateTime?
  age                Int?
  discoveryCategory  String?           @map("discovery_category") @db.VarChar(32)
  showMeCategories   String[]          @default([]) @map("show_me_categories")
  minAgePref         Int?              @map("min_age_pref")
  maxAgePref         Int?              @map("max_age_pref")
  discoveryMode      String?           @map("discovery_mode") @db.VarChar(16)
  preferencesConfirmedAt DateTime?     @map("preferences_confirmed_at")
  storiesEnabled      Boolean           @default(false) @map("stories_enabled")
  allowFollowRequests Boolean           @default(false) @map("allow_follow_requests")
  eligibilityVersion Int              @default(0) @map("eligibility_version")
  discoverySample    Int              @default(dbgenerated("(floor((random() * (1048576)::double precision)))::integer")) @map("discovery_sample")
  gender             String?           @db.VarChar(50)
  showGender         Boolean           @default(true) @map("show_gender")
  orientation        String[]          @default([])
  showOrientation    Boolean           @default(true) @map("show_orientation")
  seeking            String?           @db.VarChar(50)
  distancePreference Int?              @default(100) @map("distance_preference")
  preferences        Json?
  isVerified         Boolean           @default(false) @map("is_verified")
  emailVerifiedAt    DateTime?         @map("email_verified_at")
  phoneVerifiedAt    DateTime?         @map("phone_verified_at")
  accountStatus      String            @default("active") @map("account_status") @db.VarChar(24)
  sessionVersion     Int               @default(1) @map("session_version")
  lastAccountEventSeq Int              @default(0) @map("last_account_event_seq")
  role               String            @default("user") @db.VarChar(20)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")
  attendanceMood     String?           @map("attendance_mood") @db.VarChar(100)
  campus             String?           @db.VarChar(255)
  height             Int?
  clubs              String[]          @default([])
  degree             String?           @db.VarChar(255)
  hangoutSpots       String[]          @default([]) @map("hangout_spots")
  isHosteller        Boolean?          @map("is_hosteller")
  avatarUrl          String?           @map("avatar_url") @db.VarChar(500)
  profileVideoUrl    String?           @map("profile_video_url") @db.VarChar(500)
  videoPreviewUrl    String?           @map("video_preview_url") @db.VarChar(500)
  lastActiveAt       DateTime?         @map("last_active_at")
  locationArea       String?           @map("location_area") @db.VarChar(255)
  // Snapped to a ~1km grid before storage - never store or return raw GPS.
  latitude           Decimal?          @db.Decimal(9, 6)
  longitude          Decimal?          @db.Decimal(9, 6)
  locationUpdatedAt  DateTime?         @map("location_updated_at")
  locationConsentAt  DateTime?         @map("location_consent_at")
  matchPreferences   MatchPreference[]
  matchesAsUser1     Match[]           @relation("MatchUser1")
  matchesAsUser2     Match[]           @relation("MatchUser2")
  messages           Message[]
  photos             ProfilePhoto[]
  reportsReceived    SafetyReport[]    @relation("ReportedUser")
  reportsFiled       SafetyReport[]    @relation("Reporter")
  swipesMade         Swipe[]           @relation("SwipesMade")
  swipesReceived     Swipe[]           @relation("SwipesReceived")
  sessions           UserSession[]
  studentMembership  StudentMembership?
  userScore          UserScore?
  blocksGiven        UserBlock[]       @relation("BlockerUser")
  blocksReceived     UserBlock[]       @relation("BlockedUser")
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  impressionsSeen    ProfileImpression[] @relation("ImpressionViewer")
  impressionsShown   ProfileImpression[] @relation("ImpressionShown")
  chatMediaAssets    ChatMediaAsset[]
  profileMediaAssets ProfileMediaAsset[]

  @@index([email])
  @@index([department])
  @@index([graduationYear])
  @@index([lastActiveAt])
  @@index([locationArea])
  @@index([department, graduationYear])
  @@index([gender, seeking])
  @@index([campus, isHosteller])
  @@index([isVerified, lastActiveAt])
  // Bounding-box prefilter for distance queries.
  @@index([latitude, longitude])
  @@index([discoverySample, id])
  // Partial discovery indexes (active sample and created order) are maintained in SQL migrations.
  @@index([showMeCategories], type: Gin, map: "users_discovery_categories_idx")
  @@map("users")
}

model ProfilePhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  photoUrl  String   @map("photo_url") @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

model Match {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id            String            @map("user1_id") @db.Uuid
  user2Id            String            @map("user2_id") @db.Uuid
  compatibilityScore Float?            @map("compatibility_score")
  createdAt          DateTime          @default(now()) @map("created_at")
  expiresAt          DateTime?         @map("expires_at")
  status             String            @default("active") @db.VarChar(20)
  chatSessions       ChatSession[]
  preferences        MatchPreference[]
  user1              User              @relation("MatchUser1", fields: [user1Id], references: [id])
  user2              User              @relation("MatchUser2", fields: [user2Id], references: [id])
  messages           Message[]
  safetyReports      SafetyReport[]
  mediaAssets        ChatMediaAsset[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("matches")
}

model MatchPreference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  maxAge      Int?     @map("max_age")
  minYear     Int?     @map("min_year")
  maxYear     Int?     @map("max_year")
  departments String[]
  createdAt   DateTime @default(now()) @map("created_at")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("match_preferences")
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  content   String
  photoUrl  String?   @map("photo_url") @db.VarChar(500)
  mediaKeys String[]  @default([]) @map("media_keys")
  clientMessageId String? @map("client_message_id") @db.VarChar(100)
  sentAt    DateTime  @default(now()) @map("sent_at")
  readAt    DateTime? @map("read_at")
  isDeleted Boolean   @default(false) @map("is_deleted")
  hiddenBy  String[]  @default([]) @map("hidden_by")
  messageSeq Int?      @map("message_seq")
  type       String    @default("text") @db.VarChar(20)
  metadata   Json?
  replyToId  String?   @map("reply_to_id") @db.Uuid
  storyId    String?   @map("story_id") @db.Uuid
  editedAt   DateTime? @map("edited_at")
  deletedForEveryoneAt DateTime? @map("deleted_for_everyone_at")
  revision   Int       @default(1)
  commandFingerprint String? @map("command_fingerprint") @db.VarChar(64)
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([matchId])
  @@index([sentAt])
  @@unique([matchId, messageSeq])
  @@index([matchId, sentAt, id], map: "messages_match_sent_id_idx")
  @@unique([senderId, clientMessageId])
  @@map("messages")
}

model ChatSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId       String    @unique @map("match_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  unreadCount   Int       @default(0) @map("unread_count")
  lastMessageSeq Int      @default(0) @map("last_message_seq")
  lastEventSeq Int        @default(0) @map("last_event_seq")
  createdAt     DateTime  @default(now()) @map("created_at")
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model SafetyReport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  reportedUserId String   @map("reported_user_id") @db.Uuid
  matchId        String?  @map("match_id") @db.Uuid
  reason         String?  @db.VarChar(100)
  description    String?
  sourceType     String?  @map("source_type") @db.VarChar(24)
  sourceId       String?  @map("source_id") @db.Uuid
  evidenceSnapshot Json?  @map("evidence_snapshot")
  status         String   @default("pending") @db.VarChar(20)
  moderationCaseId String? @map("moderation_case_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  match          Match?   @relation(fields: [matchId], references: [id])
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id])

  @@index([reportedUserId])
  @@index([reportedUserId, status])
  @@index([moderationCaseId])
  @@index([sourceType, sourceId])
  @@map("safety_reports")
}

model UserSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenJti   String   @unique @map("token_jti") @db.VarChar(255)
  familyId   String   @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  replacedByJti String? @unique @map("replaced_by_jti") @db.VarChar(255)
  revokedAt  DateTime? @map("revoked_at")
  revokeReason String? @map("revoke_reason") @db.VarChar(40)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime @map("expires_at")
  deviceInfo Json?    @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ChatParticipant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId String @map("match_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  unreadCount Int @default(0) @map("unread_count")
  lastReadMessageSeq Int @default(0) @map("last_read_message_seq")
  lastDeliveredMessageSeq Int @default(0) @map("last_delivered_message_seq")
  mutedUntil DateTime? @map("muted_until")
  archivedAt DateTime? @map("archived_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([matchId, userId])
  @@index([userId, updatedAt(sort: Desc), matchId])
  @@map("chat_participants")
}

model MessageReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at")
  readAt DateTime? @map("read_at")
  @@unique([messageId, recipientId])
  @@index([recipientId, readAt])
  @@map("message_receipts")
}

model MessageVisibility {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  hiddenAt DateTime @default(now()) @map("hidden_at")
  @@unique([messageId, userId])
  @@index([userId, hiddenAt])
  @@map("message_visibility")
}

model MessageReaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  emoji String @db.VarChar(16)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([messageId, userId])
  @@index([messageId, updatedAt])
  @@map("message_reactions")
}

model ChatEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId String @map("match_id") @db.Uuid
  eventSeq Int @map("event_seq")
  type String @db.VarChar(40)
  actorId String @map("actor_id") @db.Uuid
  audienceUserId String? @map("audience_user_id") @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  entityRevision Int @default(1) @map("entity_revision")
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([matchId, eventSeq])
  @@index([matchId, createdAt])
  @@map("chat_events")
}

model ChatDeviceCursor {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  deviceId String @map("device_id") @db.VarChar(100)
  matchId String @map("match_id") @db.Uuid
  lastAppliedEventSeq Int @default(0) @map("last_applied_event_seq")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([userId, deviceId, matchId])
  @@index([userId, deviceId, updatedAt])
  @@map("chat_device_cursors")
}

model AccountEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  accountSeq Int @map("account_seq")
  type String @db.VarChar(40)
  matchId String? @map("match_id") @db.Uuid
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, accountSeq])
  @@index([userId, createdAt])
  @@map("account_events")
}

model DeliveryAttempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxEventId String @map("outbox_event_id") @db.Uuid
  channel String @db.VarChar(20)
  deviceId String @map("device_id") @db.Uuid
  status String @default("pending") @db.VarChar(20)
  attempts Int @default(0)
  providerTicket String? @map("provider_ticket") @db.VarChar(255)
  lastError String? @map("last_error") @db.VarChar(500)
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([outboxEventId, channel, deviceId])
  @@index([status, updatedAt])
  @@map("delivery_attempts")
}

model Follow {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId String @map("follower_id") @db.Uuid
  followeeId String @map("followee_id") @db.Uuid
  status String @default("pending") @db.VarChar(20)
  revision Int @default(1)
  requestedAt DateTime @default(now()) @map("requested_at")
  respondedAt DateTime? @map("responded_at")
  removedAt DateTime? @map("removed_at")
  cooldownUntil DateTime? @map("cooldown_until")
  @@unique([followerId, followeeId])
  @@index([followeeId, status, requestedAt(sort: Desc), id])
  @@index([followerId, status, followeeId])
  @@map("follows")
}

model Story {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  clientPublishId String @map("client_publish_id") @db.VarChar(100)
  assetId String @map("asset_id") @db.Uuid
  caption String? @db.VarChar(200)
  audience String @default("followers") @db.VarChar(20)
  state String @default("published") @db.VarChar(20)
  revision Int @default(1)
  publishedAt DateTime @default(now()) @map("published_at")
  expiresAt DateTime @map("expires_at")
  deletedAt DateTime? @map("deleted_at")
  @@unique([ownerId, clientPublishId])
  @@index([ownerId, state, expiresAt])
  @@index([state, publishedAt(sort: Desc), id])
  @@map("stories")
}

model StoryMediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  objectKey String @unique @map("object_key") @db.VarChar(500)
  contentType String @map("content_type") @db.VarChar(100)
  maxBytes Int @map("max_bytes")
  detectedType String? @map("detected_type") @db.VarChar(100)
  checksum String? @db.VarChar(128)
  thumbnailObjectKey String? @map("thumbnail_object_key") @db.VarChar(500)
  status String @default("requested") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  processedAt DateTime? @map("processed_at")
  @@index([ownerId, status])
  @@index([status, expiresAt])
  @@map("story_media_assets")
}

model StoryView {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storyId String @map("story_id") @db.Uuid
  viewerId String @map("viewer_id") @db.Uuid
  firstVisibleAt DateTime @default(now()) @map("first_visible_at")
  @@unique([storyId, viewerId])
  @@index([storyId, firstVisibleAt(sort: Desc), id])
  @@map("story_views")
}

model StoryPreference {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewerId String @map("viewer_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  mutedUntil DateTime? @map("muted_until")
  @@unique([viewerId, authorId])
  @@map("story_preferences")
}

model ModerationCase {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectUserId        String    @map("subject_user_id") @db.Uuid
  status               String    @default("open") @db.VarChar(24)
  priority             String    @default("normal") @db.VarChar(16)
  assignedAdminId      String?   @map("assigned_admin_id") @db.Uuid
  restrictionAppliedAt DateTime? @map("restriction_applied_at")
  resolution           String?
  resolvedAt           DateTime? @map("resolved_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([subjectUserId, status])
  @@index([status, priority, createdAt])
  @@map("moderation_cases")
}

model AccountDataRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  type         String    @db.VarChar(24)
  status       String    @default("pending") @db.VarChar(24)
  result       Json?
  error        String?   @db.VarChar(500)
  scheduledFor DateTime? @map("scheduled_for")
  completedAt  DateTime? @map("completed_at")
  expiresAt    DateTime? @map("expires_at")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId, type, status])
  @@index([type, status, scheduledFor])
  @@index([status, expiresAt])
  @@map("account_data_requests")
}

model ChatMediaAsset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  objectKey String   @unique @map("object_key") @db.VarChar(500)
  contentType String @map("content_type") @db.VarChar(100)
  maxBytes Int       @map("max_bytes")
  status    String   @default("requested") @db.VarChar(24)
  detectedType String? @map("detected_type") @db.VarChar(100)
  thumbnailObjectKey String? @map("thumbnail_object_key") @db.VarChar(500)
  waveform Json?
  processedAt DateTime? @map("processed_at")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  attachedAt DateTime? @map("attached_at")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([matchId, status])
  @@index([ownerId, status])
  @@map("chat_media_assets")
}

model ProfileMediaAsset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  objectKey        String    @unique @map("object_key") @db.VarChar(500)
  previewObjectKey String?   @unique @map("preview_object_key") @db.VarChar(500)
  purpose          String    @db.VarChar(24)
  contentType      String    @map("content_type") @db.VarChar(100)
  maxBytes         Int       @map("max_bytes")
  status           String    @default("requested") @db.VarChar(24)
  processingStatus String    @default("not_required") @map("processing_status") @db.VarChar(24)
  processingError  String?   @map("processing_error") @db.VarChar(500)
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  attachedAt       DateTime? @map("attached_at")
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@map("profile_media_assets")
}

model Institution {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String              @unique @db.VarChar(40)
  name           String              @db.VarChar(255)
  allowedDomains String[]            @map("allowed_domains")
  campuses       String[]            @default([])
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")
  memberships    StudentMembership[]

  @@map("institutions")
}

model StudentMembership {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @unique @map("user_id") @db.Uuid
  institutionId      String      @map("institution_id") @db.Uuid
  institutionalEmail String      @unique @map("institutional_email") @db.VarChar(255)
  status             String      @default("verified") @db.VarChar(24)
  verificationMethod String      @default("institution_email") @map("verification_method") @db.VarChar(40)
  verifiedAt         DateTime?   @map("verified_at")
  expiresAt          DateTime?   @map("expires_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at")
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId, status])
  @@index([status, expiresAt])
  @@map("student_memberships")
}

model Swipe {
  targetSignals Json? @map("target_signals")
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  swiperId  String   @map("swiper_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  action    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  swiper    User     @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  target    User     @relation("SwipesReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([swiperId, createdAt(sort: Desc), id], map: "swipes_actor_history_idx")
  @@index([targetId])
  @@index([targetId, action, swiperId], map: "swipes_target_action_swiper_idx")
  @@index([targetId, action, createdAt(sort: Desc), swiperId], map: "swipes_incoming_order_idx")
  @@map("swipes")
}

model UserScore {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  totalSwipesOut      Int      @default(0) @map("total_swipes_out")
  totalRightSwipes    Int      @default(0) @map("total_right_swipes")
  totalSwipesReceived Int      @default(0) @map("total_swipes_received")
  totalLikesReceived  Int      @default(0) @map("total_likes_received")
  messagesSent        Int      @default(0) @map("messages_sent")
  messagesReceived    Int      @default(0) @map("messages_received")
  messagesReplied     Int      @default(0) @map("messages_replied")
  desirabilityScore   Float    @default(50.0) @map("desirability_score")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([desirabilityScore])
  @@map("user_scores")
}

model UserScoreHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  scoreType String   @default("desirability") @map("score_type") @db.VarChar(50)
  oldValue  Float    @map("old_value")
  newValue  Float    @map("new_value")
  reason    String?  @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([scoreType, createdAt])
  @@map("user_score_history")
}

model AlgorithmConfig {
  key       String   @id @db.VarChar(100)
  value     Float
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("algorithm_config")
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  body      String
  data      Json?
  actionUrl String?  @map("action_url") @db.VarChar(500)
  deliveryKey String? @unique @map("delivery_key") @db.VarChar(255)
  outboxEventId String? @map("outbox_event_id") @db.Uuid
  pushSentAt DateTime? @map("push_sent_at")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([outboxEventId])
  @@map("notifications")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic          String    @db.VarChar(80)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  deduplicationKey String  @unique @map("deduplication_key") @db.VarChar(255)
  payloadVersion Int       @default(1) @map("payload_version")
  payload        Json
  status         String    @default("pending") @db.VarChar(20)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by") @db.VarChar(100)
  lastError      String?   @map("last_error") @db.VarChar(500)
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt, createdAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model AnalyticsEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  eventData Json     @map("event_data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

/// Records which profiles were shown to which viewer.
///
/// Rolled up per (viewer, shown, day) rather than one row per impression -
/// a row per impression would reach billions of rows at scale. Writes are
/// buffered in Redis and flushed periodically by ImpressionService.
///
/// Powers: exposure fairness, click-through rate, A/B tests, and future
/// model training. None of this can be backfilled, so it must be collected
/// from the start.
model ProfileImpression {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewerId    String   @map("viewer_id") @db.Uuid
  shownId     String   @map("shown_id") @db.Uuid
  day         DateTime @db.Date
  count       Int      @default(1)
  /// Best (lowest) position this profile held in the viewer's deck.
  bestPosition Int?    @map("best_position")
  /// Set once the viewer swipes on this profile - gives CTR without a join.
  acted       Boolean  @default(false)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @updatedAt @map("last_seen_at")

  viewer User @relation("ImpressionViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  shown  User @relation("ImpressionShown", fields: [shownId], references: [id], onDelete: Cascade)

  @@unique([viewerId, shownId, day])
  @@index([shownId, day])
  @@index([viewerId, day])
  @@index([day])
  @@map("profile_impressions")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @db.VarChar(500)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("device_tokens")
}

/// A server-issued card receipt. Visibility is acknowledged once by the client.
model DiscoveryReceipt {
  id         String   @id @db.Uuid
  viewerId   String   @map("viewer_id") @db.Uuid
  candidateId String  @map("candidate_id") @db.Uuid
  deckId     String   @map("deck_id") @db.Uuid
  sequence   Int
  algorithm  Int
  deliveredAt DateTime @default(now()) @map("delivered_at")
  visibleAt  DateTime? @map("visible_at")
  @@unique([viewerId, deckId, sequence])
  @@index([deliveredAt])
  @@index([candidateId, visibleAt])
  @@map("discovery_receipts")
}

model ShadowRanking {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewerId String @map("viewer_id") @db.Uuid
  deckId String @map("deck_id") @db.Uuid
  report Json
  createdAt DateTime @default(now()) @map("created_at")
  @@index([createdAt])
  @@map("shadow_rankings")
}
