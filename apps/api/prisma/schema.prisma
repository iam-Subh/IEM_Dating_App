/// One reader's Standouts for one day (STANDOUTS_LIKES_SPEC.md 5.3). A row,
/// not a cache entry, so the set and the exposure counts survive Redis.
model StandoutDay {
  viewerId  String   @map("viewer_id") @db.Uuid
  /// The IST calendar day, as `istDay()`.
  day       String   @db.VarChar(10)
  picks     String[] @db.Uuid
  /// "Not for me": hidden, never a Pass. Kept 30 days (STANDOUTS_PLAN.md 5.1).
  hidden    String[] @default([]) @db.Uuid
  /// Each pick's slot, in the same order as `picks`: best, new or wildcard.
  slots     String[] @default([])
  /// The viewer's taste profile that day, learned from their swipes (5.3).
  taste     Json?
  /// Which algorithm chose the day: v2 (per open) or v3 (STANDOUTS_PLAN.md).
  version   String   @default("v2") @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([viewerId, day])
  @@index([day])
  @@map("standout_days")
}

/// One night run of Standouts v3 (STANDOUTS_PLAN.md 6): what it did, and the
/// fairness limits it used, which the first-open fallback reuses that day.
model StandoutRun {
  day        String    @id @db.VarChar(10)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// "live" wrote the day's sets; "shadow" only compared (v3 switched off).
  mode       String    @db.VarChar(8)
  viewers    Int       @default(0)
  sets       Int       @default(0)
  shortSets  Int       @default(0) @map("short_sets")
  relaxed    Int       @default(0)
  durationMs Int       @default(0) @map("duration_ms")
  /// { "<institutionId>:<category>": limit }
  limits     Json      @default("{}")

  @@map("standout_runs")
}

/// Shadow mode: the set v3 would have chosen, beside the one v2 served.
model StandoutShadow {
  viewerId String   @map("viewer_id") @db.Uuid
  day      String   @db.VarChar(10)
  picks    String[] @db.Uuid
  slots    String[] @default([])

  @@id([viewerId, day])
  @@map("standout_shadow")
}

