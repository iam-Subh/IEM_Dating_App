generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String?             @unique @db.VarChar(255)
  /// Google's id for this account (GOOGLE_SIGNUP_PLAN.md 4.1): how a Google sign-in finds it.
  googleSub              String?             @unique @map("google_sub") @db.VarChar(255)
  /// The Google address, shown in Settings > Account.
  googleEmail            String?             @map("google_email") @db.VarChar(255)
  googleLinkedAt         DateTime?           @map("google_linked_at")
  /// The college an unverified account chose in onboarding (GOOGLE_SIGNUP_PLAN.md 1.3):
  /// fills its campus list and its card, never who it sees. Cleared on verification.
  claimedInstitutionId   String?             @map("claimed_institution_id") @db.Uuid
  claimedInstitution     Institution?        @relation("ClaimedInstitution", fields: [claimedInstitutionId], references: [id])
  /// "Later" on the Verify your college screen (reminder 1): onboarding goes on without it.
  verifyLaterAt          DateTime?           @map("verify_later_at")
  /// The 14-day grace period ran out unverified (GOOGLE_SIGNUP_PLAN.md 2.6): hidden from others until verified.
  pausedAt               DateTime?           @map("paused_at")
  /// Grace-period warnings sent so far: 0 none, 1 day 10, 2 day 12, 3 day 13.
  graceWarningLevel      Int                 @default(0) @map("grace_warning_level") @db.SmallInt
  /// Verify reminder pushes sent so far: 0 none, 1 day 1, 2 day 3, 3 day 7 (section 4, reminder 13).
  verifyPushLevel        Int                 @default(0) @map("verify_push_level") @db.SmallInt
  /// Expiry reminders sent for the current verification: 0 none, 1 at 30 days, 2 at 7, 3 at 1 (section 5).
  expiryReminderLevel    Int                 @default(0) @map("expiry_reminder_level") @db.SmallInt
  /// The one birthday change after onboarding has been used (6.2); later changes go through support.
  birthdayChangedAt      DateTime?           @map("birthday_changed_at")
  /// The device the account was created on: a backup signal for admins (6.1).
  signupAndroidId        String?             @map("signup_android_id") @db.VarChar(64)
  /// Passed the real-person check (selfie); only the person sees it (PHOTO_VERIFICATION_PLAN.md). Never a badge.
  realPersonVerifiedAt   DateTime?           @map("real_person_verified_at")
  /// Has passed the check at least once (kept while a later photo needs fixing). The 14-day rule
  /// for Google accounts reads this, so a photo changed later never pauses the profile.
  realPersonPassedAt     DateTime?           @map("real_person_passed_at")
  name                   String              @db.VarChar(255)
  passwordHash           String              @map("password_hash") @db.VarChar(255)
  college                String?             @db.VarChar(255)
  department             String?             @db.VarChar(100)
  graduationYear         Int?                @map("graduation_year")
  yearOfStudy            Int?                @map("year_of_study")
  birthday               DateTime?
  age                    Int?
  discoveryCategory      String?             @map("discovery_category") @db.VarChar(32)
  showMeCategories       String[]            @default([]) @map("show_me_categories")
  minAgePref             Int?                @map("min_age_pref")
  maxAgePref             Int?                @map("max_age_pref")
  discoveryMode          String?             @map("discovery_mode") @db.VarChar(16)
  preferencesConfirmedAt DateTime?           @map("preferences_confirmed_at")
  storiesEnabled         Boolean             @default(false) @map("stories_enabled")
  allowFollowRequests    Boolean             @default(false) @map("allow_follow_requests")
  /// Who may reply to and react to your Stories: matches, close_friends or off.
  storyReplies           String              @default("matches") @map("story_replies") @db.VarChar(16)
  /// Who may put you in a mention sticker: everyone, following or off.
  storyMentions          String              @default("everyone") @map("story_mentions") @db.VarChar(16)
  /// People you mention may add your Story to theirs.
  storyResharing         Boolean             @default(true) @map("story_resharing")
  /// This person's Story viewer blocks screenshots and screen recording.
  storyScreenshotBlock   Boolean             @default(true) @map("story_screenshot_block")
  /// Roses left this week: a scarce, higher-priority Like (EXPLORE_SPEC.md, section 10).
  roses                  Int                 @default(5)
  /// When the weekly grant last topped this account up. The top-up is lazy, on read or spend.
  rosesRefreshedAt       DateTime            @default(now()) @map("roses_refreshed_at")
  /// When the one-time new-user Roses were given (STANDOUTS_PLAN.md 4.2). Null: not yet.
  welcomeRosesAt         DateTime?           @map("welcome_roses_at")
  /// A Story is kept privately after it ends, in the owner's Archive.
  storyArchive           Boolean             @default(true) @map("story_archive")
  /// Every Story is saved to the device gallery the moment it is shared.
  /// Your follower and following counts show on your profile in Search (SEARCH_SPEC.md 5.1).
  showFollowerCount      Boolean             @default(true) @map("show_follower_count")
  storySaveToGallery     Boolean             @default(false) @map("story_save_to_gallery")
  eligibilityVersion     Int                 @default(0) @map("eligibility_version")
  discoverySample        Int                 @default(dbgenerated("(floor((random() * (1048576)::double precision)))::integer")) @map("discovery_sample")
  gender                 String?             @db.VarChar(50)
  showGender             Boolean             @default(true) @map("show_gender")
  orientation            String[]            @default([])
  showOrientation        Boolean             @default(true) @map("show_orientation")
  seeking                String?             @db.VarChar(50)
  distancePreference     Int?                @default(100) @map("distance_preference")
  /// How distances are shown to this person: 'km' or 'mi'. Stored and compared in km always.
  distanceUnit           String              @default("km") @map("distance_unit") @db.VarChar(2)
  preferences            Json?
  isVerified             Boolean             @default(false) @map("is_verified")
  emailVerifiedAt        DateTime?           @map("email_verified_at")
  accountStatus          String              @default("active") @map("account_status") @db.VarChar(24)
  sessionVersion         Int                 @default(1) @map("session_version")
  lastAccountEventSeq    Int                 @default(0) @map("last_account_event_seq")
  role                   String              @default("user") @db.VarChar(20)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at")
  attendanceMood         String?             @map("attendance_mood") @db.VarChar(100)
  campus                 String?             @db.VarChar(255)
  height                 Int?
  clubs                  String[]            @default([])
  degree                 String?             @db.VarChar(255)
  hangoutSpots           String[]            @default([]) @map("hangout_spots")
  isHosteller            Boolean?            @map("is_hosteller")
  avatarUrl              String?             @map("avatar_url") @db.VarChar(500)
  profileVideoUrl        String?             @map("profile_video_url") @db.VarChar(500)
  videoPreviewUrl        String?             @map("video_preview_url") @db.VarChar(500)
  videoPosterUrl         String?             @map("video_poster_url") @db.VarChar(500)
  videoPlaybackUrl       String?             @map("video_playback_url") @db.VarChar(500)
  lastActiveAt           DateTime?           @map("last_active_at")
  /// A suspension ends on its own at this time (admin panel).
  suspendedUntil         DateTime?           @map("suspended_until")
  /// The Terms and Privacy Policy version they agreed to (legal/documents.ts LEGAL_VERSION), and when.
  termsVersion           Int                 @default(0) @map("terms_version")
  termsAcceptedAt        DateTime?           @map("terms_accepted_at")
  /// Hidden Words: messages and notes containing these are folded away for this person.
  hiddenWords            String[]            @default([]) @map("hidden_words")
  /// DPDP nominee: { name, contact, relation }.
  nominee                Json?
  /// The yearly reminder of the rules (IT Rules 2021).
  rulesRemindedAt        DateTime?           @map("rules_reminded_at")
  showOnlineStatus       Boolean             @default(true) @map("show_online_status")
  /// "Active now" / "Recently active" on your cards for people you haven't matched.
  /// Both ways: off also hides theirs from you (services/presence.service.ts).
  showRecentlyActive     Boolean             @default(true) @map("show_recently_active")
  /// Findable by name in Search by people at the same college (SEARCH_SPEC.md, section 7).
  searchDiscoverable     Boolean             @default(true) @map("search_discoverable")
  /// "Who can find me by name": also accounts that haven't verified their college (GOOGLE_SIGNUP_PLAN.md, Search). Off: verified students only.
  searchByUnverified     Boolean             @default(false) @map("search_by_unverified")
  /// My preferences, More criteria (PREFERENCES_SPEC.md): { [criterionId]: { values, required } }.
  /// A soft choice ranks; `required` ("Must match") filters, both ways.
  matchCriteria          Json                @default("{}") @map("match_criteria")
  /// Keep age flexible: up to AGE_FLEX_YEARS outside the range, strict range first.
  flexibleAge            Boolean             @default(true) @map("flexible_age")
  /// Verified profiles only, both ways, like "show me".
  verifiedOnly           Boolean             @default(false) @map("verified_only")
  /// Everything in Likes You received before this has been seen (STANDOUTS_LIKES_SPEC.md 4.4).
  likesSeenAt            DateTime?           @map("likes_seen_at")
  /// Push notifications for Likes received (4.4). Roses have their own switch now.
  notifyLikes            Boolean             @default(true) @map("notify_likes")
  /// App settings: { [notification key]: boolean }. Missing keys use the catalogue's
  /// default (services/app-settings.service.ts).
  notificationPrefs      Json                @default("{}") @map("notification_prefs")
  /// When the last batched "You have new Likes" push went out (4.4).
  likesPushedAt          DateTime?           @map("likes_pushed_at")
  locationArea           String?             @map("location_area") @db.VarChar(255)
  // Snapped to a ~2km grid (0.02 deg) before storage - never store or return raw GPS.
  latitude               Decimal?            @db.Decimal(9, 6)
  longitude              Decimal?            @db.Decimal(9, 6)
  locationUpdatedAt      DateTime?           @map("location_updated_at")
  locationConsentAt      DateTime?           @map("location_consent_at")
  /// LOCATION_SPEC.md. 'precise' or 'approximate', as the phone reported the last fix.
  locationAccuracy       String?             @map("location_accuracy") @db.VarChar(16)
  /// The accuracy radius the phone reported, in metres.
  locationAccuracyM      Int?                @map("location_accuracy_m")
  /// 'live' follows the phone; 'place' pins you to a saved place (section 7).
  locationSource         String              @default("live") @map("location_source") @db.VarChar(8)
  activePlaceId          String?             @map("active_place_id") @db.Uuid
  /// Set while the phone is inside a saved place marked "hide me here":
  /// the person is out of everyone's distance discovery until a fix lands
  /// somewhere else (LOCATION_SPEC.md 7).
  locationHiddenAt       DateTime?           @map("location_hidden_at")
  /// The last accepted *live* cell: the speed check's baseline, which switching
  /// to a saved place must not move, or switching back would look like a jump.
  liveLatitude           Decimal?            @map("live_latitude") @db.Decimal(9, 6)
  liveLongitude          Decimal?            @map("live_longitude") @db.Decimal(9, 6)
  liveUpdatedAt          DateTime?           @map("live_updated_at")
  /// Show people further away once everyone inside the area has been seen:
  /// beyond the radius in distance mode, one scope wider in college mode.
  expandRadius           Boolean             @default(true) @map("expand_radius")
  hideDistance           Boolean             @default(false) @map("hide_distance")
  hideFromMaps           Boolean             @default(false) @map("hide_from_maps")
  /// Invisible hours, as minutes after midnight IST. Both null means off.
  invisibleStart         Int?                @map("invisible_start") @db.SmallInt
  invisibleEnd           Int?                @map("invisible_end") @db.SmallInt
  /// campus | college | city | group - how far college mode reaches (section 8.4).
  collegeScope           String              @default("college") @map("college_scope") @db.VarChar(16)
  campusId               String?             @map("campus_id") @db.Uuid
  campusRef              InstitutionCampus?  @relation(fields: [campusId], references: [id])
  matchPreferences       MatchPreference[]
  matchesAsUser1         Match[]             @relation("MatchUser1")
  matchesAsUser2         Match[]             @relation("MatchUser2")
  messages               Message[]
  photos                 ProfilePhoto[]
  reportsReceived        SafetyReport[]      @relation("ReportedUser")
  reportsFiled           SafetyReport[]      @relation("Reporter")
  swipesMade             Swipe[]             @relation("SwipesMade")
  swipesReceived         Swipe[]             @relation("SwipesReceived")
  sessions               UserSession[]
  studentMembership      StudentMembership?
  userScore              UserScore?
  blocksGiven            UserBlock[]         @relation("BlockerUser")
  blocksReceived         UserBlock[]         @relation("BlockedUser")
  notifications          Notification[]
  pushLogs               PushLog[]
  pushQueue              PushQueue[]
  pushEngagement         PushEngagement?
  deviceTokens           DeviceToken[]
  impressionsSeen        ProfileImpression[] @relation("ImpressionViewer")
  impressionsShown       ProfileImpression[] @relation("ImpressionShown")
  chatMediaAssets        ChatMediaAsset[]
  profileMediaAssets     ProfileMediaAsset[]

  @@index([email])
  @@index([department])
  @@index([graduationYear])
  @@index([lastActiveAt])
  @@index([locationArea])
  @@index([department, graduationYear])
  @@index([gender, seeking])
  @@index([campus, isHosteller])
  @@index([isVerified, lastActiveAt])
  // Bounding-box prefilter for distance queries.
  @@index([latitude, longitude])
  @@index([campusId])
  @@index([discoverySample, id])
  // Partial discovery indexes (active sample and created order) are maintained in SQL migrations.
  @@index([showMeCategories], type: Gin, map: "users_discovery_categories_idx")
  @@map("users")
}

model ProfilePhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  photoUrl  String   @map("photo_url") @db.VarChar(500)
  /// Card-sized rendition shown in discovery; null until processed.
  cardUrl   String?  @map("card_url") @db.VarChar(500)
  thumbUrl  String?  @map("thumb_url") @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

model Match {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id            String            @map("user1_id") @db.Uuid
  user2Id            String            @map("user2_id") @db.Uuid
  compatibilityScore Float?            @map("compatibility_score")
  createdAt          DateTime          @default(now()) @map("created_at")
  expiresAt          DateTime?         @map("expires_at")
  status             String            @default("active") @db.VarChar(20)
  /// When each person first opened this match: the "new" dot in New matches.
  user1SeenAt        DateTime?         @map("user1_seen_at")
  user2SeenAt        DateTime?         @map("user2_seen_at")
  messageTtlSeconds  Int?              @map("message_ttl_seconds")
  chatSessions       ChatSession[]
  preferences        MatchPreference[]
  user1              User              @relation("MatchUser1", fields: [user1Id], references: [id])
  user2              User              @relation("MatchUser2", fields: [user2Id], references: [id])
  messages           Message[]
  safetyReports      SafetyReport[]
  mediaAssets        ChatMediaAsset[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("matches")
}

model MatchPreference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  maxAge      Int?     @map("max_age")
  minYear     Int?     @map("min_year")
  maxYear     Int?     @map("max_year")
  departments String[]
  createdAt   DateTime @default(now()) @map("created_at")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("match_preferences")
}

model ChatMessageMark {
  messageId String   @map("message_id") @db.Uuid
  scopeId   String   @map("scope_id") @db.Uuid
  kind      String   @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([messageId, scopeId, kind])
  @@index([scopeId, kind, createdAt])
  @@map("chat_message_marks")
}

model Message {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId              String    @map("match_id") @db.Uuid
  senderId             String    @map("sender_id") @db.Uuid
  content              String
  photoUrl             String?   @map("photo_url") @db.VarChar(500)
  mediaKeys            String[]  @default([]) @map("media_keys")
  clientMessageId      String?   @map("client_message_id") @db.VarChar(100)
  sentAt               DateTime  @default(now()) @map("sent_at")
  readAt               DateTime? @map("read_at")
  isDeleted            Boolean   @default(false) @map("is_deleted")
  hiddenBy             String[]  @default([]) @map("hidden_by")
  messageSeq           Int?      @map("message_seq")
  type                 String    @default("text") @db.VarChar(20)
  metadata             Json?
  replyToId            String?   @map("reply_to_id") @db.Uuid
  storyId              String?   @map("story_id") @db.Uuid
  editedAt             DateTime? @map("edited_at")
  deletedForEveryoneAt DateTime? @map("deleted_for_everyone_at")
  expiresAt            DateTime? @map("expires_at")
  revision             Int       @default(1)
  commandFingerprint   String?   @map("command_fingerprint") @db.VarChar(64)
  match                Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender               User      @relation(fields: [senderId], references: [id])

  @@unique([matchId, messageSeq])
  @@unique([senderId, clientMessageId])
  @@index([matchId])
  @@index([sentAt])
  @@index([matchId, sentAt, id], map: "messages_match_sent_id_idx")
  @@map("messages")
}

model ChatSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId        String    @unique @map("match_id") @db.Uuid
  lastMessageAt  DateTime? @map("last_message_at")
  unreadCount    Int       @default(0) @map("unread_count")
  lastMessageSeq Int       @default(0) @map("last_message_seq")
  lastEventSeq   Int       @default(0) @map("last_event_seq")
  createdAt      DateTime  @default(now()) @map("created_at")
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model SafetyReport {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId       String   @map("reporter_id") @db.Uuid
  reportedUserId   String   @map("reported_user_id") @db.Uuid
  matchId          String?  @map("match_id") @db.Uuid
  reason           String?  @db.VarChar(100)
  description      String?
  sourceType       String?  @map("source_type") @db.VarChar(24)
  sourceId         String?  @map("source_id") @db.Uuid
  evidenceSnapshot Json?    @map("evidence_snapshot")
  status           String   @default("pending") @db.VarChar(20)
  moderationCaseId String?  @map("moderation_case_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  match            Match?   @relation(fields: [matchId], references: [id])
  reportedUser     User     @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reporter         User     @relation("Reporter", fields: [reporterId], references: [id])

  @@index([reportedUserId])
  @@index([reportedUserId, status])
  @@index([moderationCaseId])
  @@index([sourceType, sourceId])
  @@map("safety_reports")
}

model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenJti      String    @unique @map("token_jti") @db.VarChar(255)
  familyId      String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  replacedByJti String?   @unique @map("replaced_by_jti") @db.VarChar(255)
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?   @map("revoke_reason") @db.VarChar(40)
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime  @map("expires_at")
  deviceInfo    Json?     @map("device_info")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ChatParticipant {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                 String    @map("match_id") @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  unreadCount             Int       @default(0) @map("unread_count")
  lastReadMessageSeq      Int       @default(0) @map("last_read_message_seq")
  lastDeliveredMessageSeq Int       @default(0) @map("last_delivered_message_seq")
  mutedUntil              DateTime? @map("muted_until")
  archivedAt              DateTime? @map("archived_at")
  pinnedAt                DateTime? @map("pinned_at")
  markedUnread            Boolean   @default(false) @map("marked_unread")
  clearedThroughSeq       Int       @default(0) @map("cleared_through_seq")
  hiddenAt                DateTime? @map("hidden_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([matchId, userId])
  @@index([userId, updatedAt(sort: Desc), matchId])
  @@map("chat_participants")
}

model MessageReceipt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  /// A voice note was listened to: the sender's blue microphone (MESSAGE_NOTIFICATIONS_PLAN.md 7).
  playedAt    DateTime? @map("played_at")

  @@unique([messageId, recipientId])
  @@index([recipientId, readAt])
  @@map("message_receipts")
}

model MessageVisibility {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  hiddenAt  DateTime @default(now()) @map("hidden_at")

  @@unique([messageId, userId])
  @@index([userId, hiddenAt])
  @@map("message_visibility")
}

model MessageReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(16)
  revision  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([messageId, userId])
  @@index([messageId, updatedAt])
  @@map("message_reactions")
}

model ChatEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId        String   @map("match_id") @db.Uuid
  eventSeq       Int      @map("event_seq")
  type           String   @db.VarChar(40)
  actorId        String   @map("actor_id") @db.Uuid
  audienceUserId String?  @map("audience_user_id") @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  entityRevision Int      @default(1) @map("entity_revision")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([matchId, eventSeq])
  @@index([matchId, createdAt])
  @@map("chat_events")
}

model ChatDeviceCursor {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  deviceId            String   @map("device_id") @db.VarChar(100)
  matchId             String   @map("match_id") @db.Uuid
  lastAppliedEventSeq Int      @default(0) @map("last_applied_event_seq")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, deviceId, matchId])
  @@index([userId, deviceId, updatedAt])
  @@map("chat_device_cursors")
}

model AccountEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  accountSeq Int      @map("account_seq")
  type       String   @db.VarChar(40)
  matchId    String?  @map("match_id") @db.Uuid
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, accountSeq])
  @@index([userId, createdAt])
  @@map("account_events")
}

model DeliveryAttempt {
