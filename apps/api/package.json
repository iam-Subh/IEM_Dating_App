    "discovery:benchmark": "tsx scripts/benchmark-discovery.ts",
    "discovery:verify-indexes": "tsx scripts/verify-discovery-indexes.ts",
    "discovery:evaluate-reciprocity": "tsx scripts/evaluate-reciprocity.ts",
    "discovery:report": "tsx scripts/discovery-report.ts",
    "discovery:maintenance": "tsx scripts/discovery-maintenance.ts",
    "discovery:reconcile-counters": "tsx scripts/reconcile-swipe-counters.ts",
    "load:test": "tsx scripts/load-test.ts",
