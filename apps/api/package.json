    "chat-story:maintenance": "tsx scripts/chat-story-maintenance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@iem-dating/shared": "1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
