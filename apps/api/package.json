{
  "name": "@iem-dating/api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/recommendation.test.ts",
    "test:integration": "tsx --test tests/recommendation.integration.test.ts",
    "test:security": "tsx --test tests/security.integration.test.ts",
    "test:outbox": "tsx --test tests/outbox.integration.test.ts",
    "test:chat-stories": "tsx --test tests/chat-stories.integration.test.ts",
    "test:chat-regression": "tsx --test tests/chat-regression.test.ts",
    "test:flow": "tsx --test tests/flow.test.ts",
    "test:all": "npm run test:flow && npm run test && npm run test:integration && npm run test:security && npm run test:outbox && npm run test:chat-stories && npm run test:chat-regression",
    "auth:revoke-all-sessions": "tsx scripts/revoke-all-sessions.ts",
    "outbox:status": "tsx scripts/outbox-maintenance.ts status",
